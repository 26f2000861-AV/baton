# Baton — environment template (copy to .env and fill in real values)
# Never commit the real .env file.

# Database: Neon Postgres in production (postgresql://...); local dev may use
# SQLite via scripts/dev-db.sh (DATABASE_URL="file:./db/baton-dev.db").
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# NextAuth — set to your deployed origin in production.
NEXTAUTH_URL="https://your-domain.example"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# GitHub OAuth app (github.com/settings/developers → New OAuth App).
# Callback URL: {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# Optional server-level GitHub token (github.com → Settings → Developer
# settings → Fine-grained or classic PAT, read-only public repos is enough).
# Import authentication falls back automatically:
#   1. the signed-in user's OAuth token  (5,000 req/h)
#   2. this GITHUB_PAT                  (5,000 req/h, shared fallback)
#   3. unauthenticated                  (60 req/h, public repos only)
# Leave empty in production if you prefer every member to use their own
# connection.
GITHUB_PAT=""
