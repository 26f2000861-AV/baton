# Baton — Environment Configuration Template
# Copy this to .env.local (or .env) and set your actual values.
# Never commit .env or .env.local to version control.

# Database:
# - Production: Neon Postgres (postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require)
# - Local dev: SQLite (file:./db/baton-dev.db)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# NextAuth / Auth.js Application URL
# - Production:  https://www.gitlostbaton.xyz
# - Development: http://localhost:3000
NEXTAUTH_URL="https://www.gitlostbaton.xyz"

# Secret used to encrypt session tokens and JWE cookies
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Alternatively (NextAuth legacy):
NEXTAUTH_SECRET=""

# GitHub OAuth App credentials (from https://github.com/settings/developers)
# Required Authorization callback URLs in GitHub OAuth App settings:
#   Production:  https://www.gitlostbaton.xyz/api/auth/callback/github
#   Development: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Alternatively:
GITHUB_ID=""
GITHUB_SECRET=""

# Optional server-level GitHub token for fallback imports (public repositories)
GITHUB_PAT=""
