import test from 'node:test'
import assert from 'node:assert/strict'
import { GET } from '../src/app/api/health/route.ts'

test('GET /api/health returns 200 with status ok and service identity', async () => {
  const response = await GET()
  assert.equal(response.status, 200)
  const body = await response.json()
  assert.equal(body.status, 'ok')
  assert.equal(body.service, 'baton')
  assert.equal(typeof body.version, 'string')
})

test('GET /api/health reports a fresh ISO-8601 timestamp', async () => {
  const response = await GET()
  const body = await response.json()
  const parsed = Date.parse(body.timestamp)
  assert.ok(!Number.isNaN(parsed), `timestamp is ISO-8601 parseable: ${body.timestamp}`)
  // Timestamp must be fresh — generated by this request, not a cached build artifact.
  assert.ok(
    Math.abs(Date.now() - parsed) < 60_000,
    'timestamp is within one minute of now'
  )
})

test('GET /api/health is never cached and exposes process uptime', async () => {
  const response = await GET()
  assert.equal(response.headers.get('cache-control'), 'no-store')
  const body = await response.json()
  assert.ok(
    Number.isFinite(body.uptimeSeconds) && body.uptimeSeconds >= 0,
    `uptimeSeconds is a non-negative number: ${body.uptimeSeconds}`
  )
})
